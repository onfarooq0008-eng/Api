# Copy to .env  (install.sh does this for you)

# Port the server listens on (Koyeb/Docker: leave 8000)
PORT=8000

# OPTIONAL access key(s). Leave EMPTY = open API, no key needed (default).
# If set, clients must send the header "X-API-Key: <key>". Comma-separated for several keys.
API_KEYS=

# Public base URL, used to build absolute proxy links in responses.
# Leave empty to auto-detect from the request.  e.g. https://api.example.com
PUBLIC_URL=

# Number of reverse proxies in front of the app (Koyeb = 1, Caddy/nginx = 1, none = 0)
TRUST_PROXY=0

# CORS: * or comma-separated origins (native Android apps don't need CORS)
CORS_ORIGIN=*

# Rate limits (per client IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
FETCH_MEDIA_RATE_LIMIT_MAX=15

# Downloader
DOWNLOAD_TIMEOUT_MS=25000
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=300

# File proxy (/api/fetch-media)
# Comma-separated host allowlist (subdomains included). Empty = any public host.
FETCH_MEDIA_ALLOWED_HOSTS=
# Max bytes per proxied file, 0 = unlimited
FETCH_MEDIA_MAX_BYTES=0
FETCH_MEDIA_TIMEOUT_MS=20000

# Serve the built-in web tester at "/"  (true/false)
SERVE_TESTER=true

# "btch" (real) or "mock" (fake data, for developing your app offline)
PROVIDER=btch
